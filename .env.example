# Drug Repurposing RAG Engine - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# Ollama (local) - default provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI (fallback) - requires API key
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# =============================================================================
# HUGGINGFACE
# =============================================================================
# Optional: for private models or higher rate limits
HF_TOKEN=your-huggingface-token-here
HF_HOME=.cache/huggingface

# =============================================================================
# DATA SOURCES
# =============================================================================
# PubMed FTP (for bulk downloads)
PUBMED_FTP_HOST=ftp.ncbi.nlm.nih.gov
PUBMED_FTP_USER=anonymous
PUBMED_FTP_PASS=your-email@example.com

# ChEMBL (for downloads)
CHEMBL_VERSION=33
CHEMBL_FTP_HOST=ftp.ebi.ac.uk

# =============================================================================
# PATHWAYS
# =============================================================================
# Reactome (no auth required for public API)
REACTOME_BASE_URL=https://reactome.org/ContentService

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/rag_engine.log